{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webapp",
  "compatibility_date": "2026-04-26",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // Storage is now Supabase (Postgres). Credentials are provided as secrets:
  //   SUPABASE_URL, SUPABASE_SERVICE_KEY
  // Local dev reads them from .dev.vars; production from `wrangler pages secret put`.
}
